colnames(prediction_gt_droughtexp)[3] <- "Prediction_IID"
## Merging with scoring data
MR_score_GT_pred <- left_join(prediction_gt_droughtexp, MR_score_IID, by="IID")
MR_score_pred_GT <- left_join(MR_score_IID, prediction_gt_droughtexp, by="IID")
