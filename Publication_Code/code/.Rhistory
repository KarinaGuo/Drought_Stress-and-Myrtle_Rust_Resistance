cities <- data.frame(
city = c("Newcastle, NSW", "Port Macquarie, NSW", "Coffs Harbour, NSW"),
lat  = c(-32.9283, -31.4349, -30.2962),
lon  = c(151.7817, 152.9002, 153.1139)
)
Mat_Line_NSW_Plot <- ggplot() +
#xlim(c(min_long, max_long)) + ylim(c(min_lat, max_lat)) +
geom_spatraster(data=annual_prec_NSW) +
geom_point(data = cities, aes(x = lon, y = lat), size = 2, colour = "grey90") +
geom_text(data = cities, aes(x = lon + 0.5, y = lat, label = city), colour = "grey40", size = 2, hjust = 0) +
geom_point(data=parent_meta_rel,aes(y=latitude, x=longitude), size = 3, colour="black") +
geom_point(data=parent_meta_rel,aes(y=latitude, x=longitude, colour = as.numeric(mean_COI))) +
ggrepel::geom_text_repel(data = parent_meta_rel, aes(x = longitude, y = latitude, label = round(mean_COI,1), colour = as.numeric(mean_COI)), nudge_x = 0.5, box.padding = 0.5, size=3) +
scale_colour_gradient(low = "chartreuse4", high = "coral2") +
scale_fill_viridis_c(na.value = NA, option="turbo") +
xlab(expression(paste("Longitude ("^"o",")"))) + ylab(expression(paste("Latitude ("^"o",")"))) +
guides(fill=guide_legend(title="Mean annual \nprecipitation (mm)"), colour=guide_legend(title="Mean COI")) +
theme_bw()
ggsave(Mat_Line_NSW_Plot, filename="Publication/Figures/Mat_Line_NSW_Plot_SI.jpg", unit='px', width = 1500, height = 2000, limitsize=F)
