prediction_gt <- read.csv("D:/LaptopLenovo_03022026/Uni/Doctorate/Samples/Genotyping/Report-DMela25-10753/Report-DMela25-10753/GP_Out_rmclimsnps/prediction_gt.csv") %>% dplyr::select(c(Taxa, PEV, Prediction))
colnames(prediction_gt)[1] <- "NSWID"
